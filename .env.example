# ============================================================
# PlacementOS — Environment Configuration Template
# Stack: Google Gemini API + Supabase PostgreSQL & Auth
# ============================================================

# Supabase Configuration
# Replace with your Supabase Project URL & Anon Key from project settings:
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini API Key (Gemini 1.5 Flash)
# Get your free key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key

# Optional: Server-side Supabase Edge Functions config
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
